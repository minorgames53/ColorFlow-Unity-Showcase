      m_Items: []
  - m_Id: 880000000000000019
    m_Localized: USTAWIENIA
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000020
    m_Localized: "Uzupe\u0142nij \u017Cycia!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000021
    m_Localized: ODBIERZ
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000022
    m_Localized: "Uzupe\u0142nij"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000023
    m_Localized: "Nast\u0119pne \u017Cycie:"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000024
    m_Localized: +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000025
