    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000007
    m_Localized: "Usu\u0144 na sta\u0142e reklamy przerywaj\u0105ce gr\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000008
    m_Localized: "Graj bez po\u0142\u0105czenia z internetem!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000009
    m_Localized: "Reklamy z nagrod\u0105 s\u0105 opcjonalne."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000010
