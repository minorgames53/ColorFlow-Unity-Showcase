    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000013
    m_Localized: "Przywr\xF3\u0107 zakupy"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000014
    m_Localized: Kontakt
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000015
    m_Localized: "Prywatno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000016
