    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000026
    m_Localized: TRUDNY
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000027
    m_Localized: BARDZO TRUDNY
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000028
    m_Localized: x3
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000029
    m_Localized: "Pakiety z\u0142ota"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000030
    m_Localized: "Zacznij z zapasem z\u0142ota i pot\u0119\u017Cnymi dopalaczami!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000031
    m_Localized: "\u015Awietny pocz\u0105tek!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000032
    m_Localized: Pakiet startowy
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000033
    m_Localized: "Usu\u0144 na sta\u0142e wszystkie uci\u0105\u017Cliwe reklamy!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000034
    m_Localized: Sklep
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000038
    m_Localized: NAGRODY
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000039
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000040
    m_Localized: Nagroda x2
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000042
    m_Localized: Przegrana
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000043
    m_Localized: "Pon\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000044
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000045
    m_Localized: "Poddaj si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000046
    m_Localized: "Poddaj si\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000047
    m_Localized: "Stracisz 1 \u017Cycie!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000048
    m_Localized: "R\u0118KA"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000049
    m_Localized: "Wybierz dowolne pude\u0142ko i u\u017Cyj go od razu."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000050
    m_Localized: TASOWANIE
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000051
    m_Localized: "Przetasuj pude\u0142ka i zmie\u0144 ich kolejno\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000052
    m_Localized: UFO
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000053
    m_Localized: "Usu\u0144 kulki z ta\u015Bmy."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000054
    m_Localized: "Wyczy\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000055
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000056
    m_Localized: BRAK MIEJSCA!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000057
    m_Localized: "Oczy\u015B\u0107 plansz\u0119 i zr\xF3b miejsce, by gra\u0107 dalej."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000058
    m_Localized: Dalej!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000059
    m_Localized: Oferta specjalna
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000060
    m_Localized: Kontynuuj za darmo
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000061
    m_Localized: Poz
    m_Metadata:
      m_Items: []
  - m_Id: 21084741340917760
    m_Localized: ODBIERZ
    m_Metadata:
      m_Items: []
  - m_Id: 26453810227343360
    m_Localized: "BRAK PO\u0141\u0104CZENIA"
    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675008
    m_Localized: "Wymagany jest internet.\nUpewnij si\u0119, \u017Ce masz\naktywne
      po\u0142\u0105czenie."
    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675009
    m_Localized: "Od\u015Bwie\u017C"
    m_Metadata:
      m_Items: []
  - m_Id: 28618018821926912
    m_Localized: "Zakup nie powi\xF3d\u0142 si\u0119. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869952
    m_Localized: Zakup czeka na zatwierdzenie.
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869953
    m_Localized: "Zakupy przywr\xF3cone."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869954
    m_Localized: "Brak zakup\xF3w do przywr\xF3cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869955
    m_Localized: "Nie uda\u0142o si\u0119 przywr\xF3ci\u0107 zakup\xF3w. Spr\xF3buj
      ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869956
    m_Localized: '{0} Opinie {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869957
    m_Localized: Nieznane
    m_Metadata:
      m_Items: []
  - m_Id: 29065322175557632
    m_Localized: "<color=#27A9E8>Dotknij</color> <color=red>pude\u0142ka z kulkami</color>
      i dopasuj kolor do pude\u0142ka poni\u017Cej."
    m_Metadata:
      m_Items: []
  - m_Id: 29070949941669888
    m_Localized: "<color=#27A9E8>Wybierz</color> <color=red>pude\u0142ko z kulkami</color>,
      by wys\u0142a\u0107 je do <color=red>pude\u0142ek w tym samym kolorze</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 29073249057796096
    m_Localized: "<color=#27A9E8>Przetasuj</color> <color=red>pude\u0142ka docelowe</color>,
      by uzyska\u0107 <color=red>lepsze dopasowania</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29076064635351040
    m_Localized: "<color=#27A9E8>Opr\xF3\u017Cnij</color> <color=red>ta\u015Bm\u0119</color>,
      wysy\u0142aj\u0105c kulki do <color=red>pude\u0142ek w tym samym kolorze</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654014529536
    m_Localized: "U\u017Cyj <color=#27A9E8>Sprz\u0105tania</color>, by zwolni\u0107
      miejsce na ta\u015Bmie. Tym razem <color=#42B96B>ZA DARMO</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654043889664
    m_Localized: ZA DARMO
    m_Metadata:
      m_Items: []
