  - m_Id: 29065322175557632
    m_Localized: <color=#27A9E8>Toca</color> numa <color=red>caixa de berlindes</color>
      e combina a cor com a caixa em baixo.
    m_Metadata:
      m_Items: []
  - m_Id: 29070949941669888
    m_Localized: "<color=#27A9E8>Seleciona</color> uma <color=red>caixa de berlindes</color>
      para os enviar \xE0s <color=red>caixas da mesma cor</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 29073249057796096
    m_Localized: "<color=#27A9E8>Baralha</color> as <color=red>caixas-alvo</color>
      para criar <color=red>melhores combina\xE7\xF5es</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29076064635351040
    m_Localized: "<color=#27A9E8>Limpa</color> o <color=red>tapete</color> enviando
      berlindes \xE0s <color=red>caixas da mesma cor</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654014529536
    m_Localized: "Usa <color=#27A9E8>Limpar</color> para libertar espa\xE7o no tapete.
