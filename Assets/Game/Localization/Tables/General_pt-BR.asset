    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675009
    m_Localized: Atualizar
    m_Metadata:
      m_Items: []
  - m_Id: 28618018821926912
    m_Localized: Falha na compra. Tente de novo.
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869952
    m_Localized: "Compra aguardando aprova\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869953
    m_Localized: Compras restauradas.
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869954
    m_Localized: Nada para restaurar.
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869955
    m_Localized: "N\xE3o foi poss\xEDvel restaurar as compras. Tente de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869956
    m_Localized: "{0} Coment\xE1rios {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869957
    m_Localized: Desconhecido
    m_Metadata:
      m_Items: []
  - m_Id: 29065322175557632
    m_Localized: <color=#27A9E8>Toque</color> numa <color=red>caixa de bolinhas</color>
      e combine a cor com a caixa abaixo.
    m_Metadata:
      m_Items: []
  - m_Id: 29070949941669888
    m_Localized: "<color=#27A9E8>Selecione</color> uma <color=red>caixa de bolinhas</color>
      para envi\xE1-las \xE0s <color=red>caixas da mesma cor</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 29073249057796096
    m_Localized: "<color=#27A9E8>Embaralhe</color> as <color=red>caixas-alvo</color>
      para criar <color=red>melhores combina\xE7\xF5es</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29076064635351040
    m_Localized: "<color=#27A9E8>Limpe</color> a <color=red>esteira</color> enviando
      bolinhas \xE0s <color=red>caixas da mesma cor</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654014529536
    m_Localized: "Use <color=#27A9E8>Limpar</color> para liberar espa\xE7o na esteira.
      Desta vez \xE9 <color=#42B96B>GR\xC1TIS</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654043889664
    m_Localized: "GR\xC1TIS"
    m_Metadata:
      m_Items: []
