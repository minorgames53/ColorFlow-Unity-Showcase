    m_Localized: OBTER
    m_Metadata:
      m_Items: []
  - m_Id: 26453810227343360
    m_Localized: "SEM CONEX\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675008
    m_Localized: "\xC9 preciso estar online.\nVerifique se voc\xEA tem\numa conex\xE3o
