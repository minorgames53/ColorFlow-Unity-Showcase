  - m_Id: 880000000000000046
    m_Localized: Desistir
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000047
    m_Localized: "Voc\xEA perder\xE1 1 vida!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000048
    m_Localized: "M\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000049
    m_Localized: Escolha uma caixa e use na hora.
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000050
    m_Localized: EMBARALHAR
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000051
    m_Localized: Embaralhe as caixas e crie uma nova ordem!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000052
    m_Localized: OVNI
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000053
    m_Localized: Limpe as bolinhas da esteira.
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000054
    m_Localized: Limpar!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000055
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000056
    m_Localized: "SEM ESPA\xC7O!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000057
    m_Localized: "Limpe o tabuleiro e libere espa\xE7o para continuar jogando."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000058
    m_Localized: Continuar!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000059
