  - m_Id: 880000000000000006
    m_Localized: REKLAMSIZ
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000007
    m_Localized: "Araya giren reklamlar\u0131 sonsuza dek kald\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000008
    m_Localized: "\u0130nternet ba\u011Flant\u0131s\u0131 olmadan oynay\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000009
    m_Localized: "\u0130ste\u011Fe ba\u011Fl\u0131 \xF6d\xFCll\xFC reklamlar kal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000010
    m_Localized: "\u0130PTAL ED\u0130LD\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000011
    m_Localized: "Sat\u0131n al\u0131m iptal edildi."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000012
    m_Localized: TAMAM
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000013
    m_Localized: "Sat\u0131n Al\u0131nanlar\u0131 Geri Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000014
    m_Localized: "Bize Ula\u015F\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000015
    m_Localized: "Gizlilik Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000016
    m_Localized: "Men\xFCye D\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000017
    m_Localized: "Titre\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000018
    m_Localized: Sesler
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000019
    m_Localized: AYARLAR
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000020
    m_Localized: Kalplerini Doldur!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000021
    m_Localized: AL
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000022
    m_Localized: "\u015Eimdi Doldur"
