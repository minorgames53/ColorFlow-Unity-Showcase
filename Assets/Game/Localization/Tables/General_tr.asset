    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000046
    m_Localized: Pes Et
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000047
    m_Localized: 1 kalp kaybedeceksin!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000048
    m_Localized: EL
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000049
    m_Localized: "\u0130stedi\u011Fin kutuyu se\xE7 ve hemen kullan."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000050
    m_Localized: "KARI\u015ETIR"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000051
    m_Localized: "Kutular\u0131 kar\u0131\u015Ft\u0131r ve yeni bir s\u0131ra olu\u015Ftur!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000052
    m_Localized: UFO
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000053
    m_Localized: "Konvey\xF6rdeki misketleri temizle."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000054
    m_Localized: Temizle!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000055
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000056
    m_Localized: YER KALMADI!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000057
    m_Localized: "Oynamaya devam etmek i\xE7in tahtay\u0131 temizle ve yer a\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000058
    m_Localized: Devam Et!
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000059
    m_Localized: "\xD6zel Teklif"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000060
    m_Localized: "B\xF6l\xFCme \xDCcretsiz Devam Et"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000061
    m_Localized: Sv
    m_Metadata:
      m_Items: []
  - m_Id: 21084741340917760
    m_Localized: AL
    m_Metadata:
      m_Items: []
  - m_Id: 26453810227343360
    m_Localized: "BA\u011ELANTI YOK"
    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675008
    m_Localized: "\u0130nternet gerekiyor,\nl\xFCtfen aktif bir ba\u011Flant\u0131\noldu\u011Fundan
      emin olun."
    m_Metadata:
      m_Items: []
  - m_Id: 26453810277675009
    m_Localized: Yenile
    m_Metadata:
      m_Items: []
  - m_Id: 28618018821926912
    m_Localized: "Sat\u0131n alma ba\u015Far\u0131s\u0131z. L\xFCtfen tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869952
    m_Localized: "Sat\u0131n alma onay bekliyor."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869953
    m_Localized: "Sat\u0131n al\u0131mlar geri y\xFCklendi."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869954
    m_Localized: "Geri y\xFCklenecek al\u0131m yok."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869955
    m_Localized: "Sat\u0131n al\u0131nanlar geri y\xFCklenemedi. L\xFCtfen tekrar
      dene."
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869956
    m_Localized: '{0} Geri Bildirim {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 28618018863869957
    m_Localized: Bilinmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 29065322175557632
    m_Localized: "Bir <color=red>misket kutusuna</color> <color=#27A9E8>dokun</color>
      ve rengini alttaki kutuyla e\u015Fle\u015Ftir."
    m_Metadata:
      m_Items: []
  - m_Id: 29070949941669888
    m_Localized: "Misketlerini <color=red>e\u015Fle\u015Fen kutulara</color> g\xF6ndermek
      i\xE7in bir <color=red>misket kutusu</color> <color=#27A9E8>se\xE7</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 29073249057796096
    m_Localized: "<color=red>Daha iyi e\u015Fle\u015Fmeler</color> i\xE7in <color=red>hedef
      kutular\u0131n\u0131</color> <color=#27A9E8>kar\u0131\u015Ft\u0131r</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29076064635351040
    m_Localized: "Misketleri <color=red>e\u015Fle\u015Fen kutulara</color> g\xF6ndererek
      <color=red>konvey\xF6r\xFC</color> <color=#27A9E8>temizle</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654014529536
    m_Localized: "<color=#27A9E8>Temizle</color> ile konvey\xF6rde yer a\xE7. Bu
      kez <color=#42B96B>\xDCCRETS\u0130Z</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654043889664
    m_Localized: "\xDCCRETS\u0130Z"
    m_Metadata:
      m_Items: []
