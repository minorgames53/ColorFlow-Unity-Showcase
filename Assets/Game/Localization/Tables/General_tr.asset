    m_Localized: x3
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000029
    m_Localized: "Alt\u0131n Paketler"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000030
    m_Localized: "Alt\u0131n ve g\xFC\xE7l\xFC desteklerle oyuna h\u0131zl\u0131
      ba\u015Fla!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000031
    m_Localized: "Harika bir ba\u015Flang\u0131\xE7!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000032
    m_Localized: "Ba\u015Flang\u0131\xE7 Paketi"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000033
    m_Localized: "Reklamlar\u0131 kal\u0131c\u0131 olarak kald\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000034
    m_Localized: "Ma\u011Faza"
    m_Metadata:
      m_Items: []
  - m_Id: 880000000000000035
