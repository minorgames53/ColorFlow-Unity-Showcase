  - m_Id: 29065322175557632
    m_Localized: "<color=#27A9E8>Tippe</color> auf eine <color=red>Kugelbox</color>
      und f\xFClle die gleichfarbige Box unten."
    m_Metadata:
      m_Items: []
  - m_Id: 29070949941669888
    m_Localized: "<color=#27A9E8>W\xE4hle</color> eine <color=red>Kugelbox</color>,
      um ihre Kugeln in <color=red>gleichfarbige Boxen</color> zu senden."
    m_Metadata:
      m_Items: []
  - m_Id: 29073249057796096
    m_Localized: "<color=#27A9E8>Mische</color> die <color=red>Zielboxen</color>
      f\xFCr <color=red>bessere Kombinationen</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 29076064635351040
    m_Localized: "<color=#27A9E8>Leere</color> das <color=red>F\xF6rderband</color>,
      indem du Kugeln in <color=red>passende Boxen</color> schickst"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654014529536
    m_Localized: "Schaffe mit <color=#27A9E8>Aufr\xE4umen</color> Platz auf dem F\xF6rderband.
      Diesmal <color=#42B96B>GRATIS</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 29083654043889664
    m_Localized: GRATIS
    m_Metadata:
      m_Items: []
